PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
# Option A: Connection URL (Supabase, Neon, Railway)
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Option B: Individual host variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=yensync_db

# JWT Configuration
JWT_SECRET=yensync_super_secret_jwt_key_2026_department
JWT_EXPIRES_IN=7d
