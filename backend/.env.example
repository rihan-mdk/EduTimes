PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database Configuration
# Option A: Connection URL (e.g. Supabase connection pooler with IPv4 support)
# DATABASE_URL=postgresql://postgres.xxx:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# Option B: Individual host variables
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_local_password
PGDATABASE=yensync_db

# JWT Configuration (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_secure_random_256bit_secret_in_production
JWT_EXPIRES_IN=7d
